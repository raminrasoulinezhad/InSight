[Desktop Entry]
# Template — install with ./install-desktop.sh, which substitutes the absolute
# uv and repo paths for your machine into the placeholders below.
Type=Application
Name=InSight
GenericName=Insider Transactions
Comment=View insider stock transactions in a desktop window
Exec=__UV__ run --script __REPO__/app.py --window
Path=__REPO__
Icon=__REPO__/webui/icon.svg
Terminal=false
Categories=Office;Finance;
Keywords=insider;stocks;trading;finance;
# Must match the --class passed to Chrome in app.py's _open_app_window so the
# window associates with this launcher (correct taskbar icon / grouping).
StartupWMClass=InSight
