# ---- Secrets — never commit real credentials ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Generated data (date-stamped scraper output) ----
# Outputs are regenerated by insight-scrape; don't commit them.
data/*.json
data/*.csv
data/by_ticker/
data/cron.log
# ...but keep the data/ directory itself in the repo.
!data/.gitkeep

# ---- Playwright ----
# Browser binaries live in ~/.cache/ms-playwright (outside the repo);
# this catches any local override.
.playwright/
playwright-report/

# ---- Claude Code ----
# Personal/local settings — never commit. Shared settings.json (if added) is fine.
.claude/settings.local.json

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Icon source ----
# High-res source art; the committed icons (insight/webui/icon*.png) and the
# README banner (assets/logo.png) are derived from it.
/icon.png

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
