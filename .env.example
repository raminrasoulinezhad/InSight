# InSight LLM keys and per-route limits.
#
#   cp .env.example .env      then fill in your own keys
#
# `.env` is gitignored and MUST NEVER BE COMMITTED. This example file is the
# only one that belongs in git, and it must never hold a real key.
#
# ---------------------------------------------------------------------------
# How the router uses this file
# ---------------------------------------------------------------------------
# Each entry in INSIGHT_LLM_ROUTES names one provider+model pair. Before every
# call the router estimates the prompt size and the reply size, drops the routes
# that cannot fit it or have no headroom left, and takes the cheapest survivor
# by PRIORITY. If that route refuses, the next one is tried.
#
# Per-route fields (only KEY, MODEL and BASE_URL are required):
#
#   KEY             the API key. Write the provider key once at the top and
#                   reference it as ${NAME}, so each key appears exactly once.
#   BASE_URL        OpenAI-compatible root, i.e. the part before /chat/completions
#   MODEL           the provider's model id
#   PRIORITY        lower is tried first (default 100)
#   RPM             requests per minute
#   INPUT_TPM       input tokens per minute
#   DAILY_TOKENS    total tokens per UTC day
#   MONTHLY_TOKENS  total tokens per calendar month
#   CONTEXT         input + output must fit in this (default 32000)
#   MAX_OUTPUT      largest reply the model will return (default 4096)
#
# A limit you leave blank is NOT enforced locally; the provider's own 429 is the
# backstop, and the router puts that route on a cooldown when it sees one. So
# blanks are safe, and filling them in only buys you fewer wasted round trips.
#
# Spend is tracked on disk (llm_usage.json in the app data folder), so a daily
# budget survives a restart.

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
TOKENROUTER_API_KEY=your-key-here
CEREBRAS_API_KEY=your-key-here

# ---------------------------------------------------------------------------
# The pool, in the order you would like them considered
# ---------------------------------------------------------------------------
INSIGHT_LLM_ROUTES=gemini_flash,gemini_flash_lite,groq_compound,groq_compound_mini

# --- Google AI Studio ------------------------------------------------------
INSIGHT_LLM_GEMINI_FLASH_KEY=${GEMINI_API_KEY}
INSIGHT_LLM_GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
INSIGHT_LLM_GEMINI_FLASH_MODEL=gemini-3.7-flash
INSIGHT_LLM_GEMINI_FLASH_PRIORITY=10
INSIGHT_LLM_GEMINI_FLASH_CONTEXT=1000000
INSIGHT_LLM_GEMINI_FLASH_MAX_OUTPUT=8192

INSIGHT_LLM_GEMINI_FLASH_LITE_KEY=${GEMINI_API_KEY}
INSIGHT_LLM_GEMINI_FLASH_LITE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
INSIGHT_LLM_GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
INSIGHT_LLM_GEMINI_FLASH_LITE_PRIORITY=20
INSIGHT_LLM_GEMINI_FLASH_LITE_CONTEXT=1000000
INSIGHT_LLM_GEMINI_FLASH_LITE_MAX_OUTPUT=8192

# --- Groq ------------------------------------------------------------------
# RPM/INPUT_TPM below are what the live x-ratelimit-* response headers reported
# for a free key, which was lower than the published table. Trust the headers.
INSIGHT_LLM_GROQ_COMPOUND_KEY=${GROQ_API_KEY}
INSIGHT_LLM_GROQ_COMPOUND_BASE_URL=https://api.groq.com/openai/v1
INSIGHT_LLM_GROQ_COMPOUND_MODEL=groq/compound
INSIGHT_LLM_GROQ_COMPOUND_PRIORITY=30
INSIGHT_LLM_GROQ_COMPOUND_RPM=250
INSIGHT_LLM_GROQ_COMPOUND_INPUT_TPM=70000
INSIGHT_LLM_GROQ_COMPOUND_CONTEXT=131072
INSIGHT_LLM_GROQ_COMPOUND_MAX_OUTPUT=8192

INSIGHT_LLM_GROQ_COMPOUND_MINI_KEY=${GROQ_API_KEY}
INSIGHT_LLM_GROQ_COMPOUND_MINI_BASE_URL=https://api.groq.com/openai/v1
INSIGHT_LLM_GROQ_COMPOUND_MINI_MODEL=groq/compound-mini
INSIGHT_LLM_GROQ_COMPOUND_MINI_PRIORITY=40
INSIGHT_LLM_GROQ_COMPOUND_MINI_RPM=250
INSIGHT_LLM_GROQ_COMPOUND_MINI_INPUT_TPM=70000
INSIGHT_LLM_GROQ_COMPOUND_MINI_CONTEXT=131072
INSIGHT_LLM_GROQ_COMPOUND_MINI_MAX_OUTPUT=8192

# --- TokenRouter -----------------------------------------------------------
# Add these to INSIGHT_LLM_ROUTES to enable them. Limits are undeclared here
# because the provider does not publish them; the 429 handling covers it.
# INSIGHT_LLM_TR_DEEPSEEK_KEY=${TOKENROUTER_API_KEY}
# INSIGHT_LLM_TR_DEEPSEEK_BASE_URL=https://api.tokenrouter.com/v1
# INSIGHT_LLM_TR_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro-0813-free
# INSIGHT_LLM_TR_DEEPSEEK_PRIORITY=50
# INSIGHT_LLM_TR_DEEPSEEK_CONTEXT=32768

# --- Cerebras --------------------------------------------------------------
# A free-trial key returned HTTP 402 "payment required" on every model, so this
# is left out of the pool. Uncomment once the account has quota.
# INSIGHT_LLM_CEREBRAS_OSS_KEY=${CEREBRAS_API_KEY}
# INSIGHT_LLM_CEREBRAS_OSS_BASE_URL=https://api.cerebras.ai/v1
# INSIGHT_LLM_CEREBRAS_OSS_MODEL=gpt-oss-120b
# INSIGHT_LLM_CEREBRAS_OSS_PRIORITY=60
# INSIGHT_LLM_CEREBRAS_OSS_RPM=5
# INSIGHT_LLM_CEREBRAS_OSS_INPUT_TPM=30000
# INSIGHT_LLM_CEREBRAS_OSS_DAILY_TOKENS=1000000
